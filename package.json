{
  "name": "@mesihtasci/scrollable",
  "version": "1.0.0-rc.1",
  "description": "A lightweight, accessible full-page and embedded vertical scroller",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p examples/react/tsconfig.json",
    "lint": "oxlint --deny-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "build:examples": "npm run build && vite build",
    "check": "npm run build && npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e && npm run test:package && npm run build:examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mesihtasci/scrollable.git"
  },
  "bugs": "https://github.com/mesihtasci/scrollable/issues",
  "author": "Mesih Tasci (mesih.t@gmail.com)",
  "license": "MIT",
  "homepage": "https://mesihtasci.github.io/scrollable/",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
